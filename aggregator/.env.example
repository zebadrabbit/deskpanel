# Copy to .env (gitignored) and fill in. Every collector is optional: leave its URL empty to skip it.

# DEMO=1 replaces every source below with lively fake data: try the panel with nothing but the
# board and Docker (PANEL_TOKEN and LISTEN are still needed).
DEMO=

# Device API. The panel sends "Authorization: Bearer $PANEL_TOKEN". Generate: openssl rand -hex 24
PANEL_TOKEN=
# Senders of panel notifications (POST /api/v1/notify) use this token, not PANEL_TOKEN, so they
# can't mark cards done. Empty = notifications off. Generate: openssl rand -hex 24
NOTIFY_TOKEN=
# Listen on the LAN address only (keeps it off the tailnet; compose uses host networking).
LISTEN=192.0.2.10:8088

# TrueNAS: JSON-RPC over wss only (TrueNAS revokes API keys it sees over plain HTTP).
# Key belongs to a read-only user (Read-Only Administrator group). Pin the self-signed cert:
#   echo | openssl s_client -connect NAS:443 2>/dev/null | openssl x509 -noout -fingerprint -sha256
TRUENAS_URL=wss://truenas.lan/api/current
TRUENAS_USER=deskpanel
TRUENAS_API_KEY=
TRUENAS_CERT_SHA256=

# GPU agents (`deskpanel agent` on each GPU host): name=url, comma separated.
GPU_AGENTS=workstation=http://workstation.lan:9835,truenas=http://truenas.lan:9835

# Plain HTTP health checks shown as up/down dots next to Tailscale: name=url, comma separated.
# A 2xx within 3 s is up.
SERVICES=jellyfin=http://nas.lan:8096/health

# Tailscale LocalAPI socket (compose mounts /var/run/tailscale from the host).
TAILSCALE_SOCKET=/var/run/tailscale/tailscaled.sock

# Planka: the boards this user is a member of are the boards on the panel. Give it editor
# membership so "Done" can move cards.
PLANKA_URL=http://planka.lan:3000
PLANKA_USER=deskpanel
PLANKA_PASSWORD=

# Weather tab (radar, conditions, NWS alerts). Leave WEATHER_LAT empty to turn it off.
# Decimal degrees of the spot the radar centres on (US only: NWS + NOAA data).
WEATHER_LAT=
WEATHER_LON=
# Radar zoom level (default 8). User-Agent sent to NWS/tile servers; NWS asks for contact info.
WEATHER_ZOOM=8
WEATHER_UA=deskpanel
# Where basemap tiles are cached; compose sets /data/weather. Empty = no disk cache.
WEATHER_CACHE=
# Your time zone, for the times in alerts ("until 3:30 PM"). Unset = UTC. For example: America/Chicago
TZ=

# Card layout, re-read every 5 s. compose mounts ./config at /config.
# No file = a layout generated from the sources found. Start from layout.example.json.
LAYOUT_FILE=/config/layout.json

# Prometheus (no auth) for the general cards: number, gauge, bar, graph, status. Unset = those cards
# read "—" with "set PROMETHEUS_URL". Queried every 30 s (graphs every 60 s).
PROMETHEUS_URL=

# A general card can read a number or a word from an app's JSON status page ({"json": {...}} in layout.json).
# A page that needs a login gets its header from a variable named CARD_<NAME>, whose value is one whole
# header line ("Name: value"); layout.json names it as "header_env". Only CARD_* variables can be sent.
#CARD_APP_TOKEN=Authorization: Bearer abc123

# Home Assistant, for {"ha": "sensor.x"} card values. HA_URL: compose uses host networking, so HA on this server is
# http://127.0.0.1:8123. HA_TOKEN: a long-lived access token (HA: your profile -> Security -> Long-lived access
# tokens), sent only to HA_URL. Unset = those cards read "—" with "set HA_URL" / "set HA_TOKEN".
HA_URL=
HA_TOKEN=
# The same two settings drive the `light` and `profile` cards. With them the panel can switch, dim and colour the
# lights and switches named by light cards in layout.json (no other entity), so the token's user needs to control those.
# Profiles saved from the panel are kept in profiles.json beside NOTES_FILE (compose: /data/profiles.json, in the
# notes volume). Set PROFILES_FILE to keep them somewhere else.
#PROFILES_FILE=/data/profiles.json

# Screen editor password: set it to open http://<server>:8088/editor/ and edit layout.json in the browser. At least
# 12 characters (`openssl rand -hex 16`) and different from PANEL_TOKEN and NOTIFY_TOKEN, or the editor stays off
# (404). Needs ./config mounted without :ro. Whoever has it can do what write access to layout.json can: keep it secret.
EDITOR_TOKEN=
